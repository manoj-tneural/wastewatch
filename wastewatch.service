[Unit]
Description=WasteWatch litter detection
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wastewatch
Group=wastewatch
WorkingDirectory=/opt/wastewatch
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wastewatch/venv/bin/python app.py --host 0.0.0.0 --port 7000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
